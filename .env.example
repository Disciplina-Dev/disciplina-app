MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=disciplina-ab
MYSQL_PASSWORD=
MYSQL_USER=

# Port exposé sur ta machine (évite "address already in use" si MySQL tourne déjà en 3306)
MYSQL_PUBLISH_PORT=3307

# Backend (DB_PORT = même valeur que MYSQL_PUBLISH_PORT si l’API tourne sur l’hôte)
DB_HOST=localhost
DB_PORT=3307
PORT=3001
FRONT_URL=http://localhost:5173

# YouSign SaaS API
YOUSIGN_API_KEY=
YOUSIGN_BASE_URL=https://api-sandbox.yousign.app/v3