MYSQL_ROOT_PASSWORD=
# Mot de passe du compte applicatif `disciplina_app` (le backend ne tourne pas en root).
# Sur un volume vierge le compte est créé automatiquement avec cette valeur. Sur une base
# existante, appliquer database/mysql/migrations/2026-08-06-app-user.sql.
# Laisser vide pour rester sur root (comportement historique).
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=

MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_PORT=
MONGO_URI=   # mongodb+srv://... — required in production (Atlas), leave empty for local dev

# Tenants — la base historique reste `disciplina` / `human_ressources` ; la seconde
# base (site Annemasse) partage les MÊMES conteneurs MySQL/MongoDB, d'où l'absence de
# ports dédiés. Le backend route chaque requête vers la base du tenant porté par le
# JWT, choisi au login ; DB_DEFAULT_TENANT régit les requêtes sans JWT (webhooks, cron).
# MYSQL_ANNEMASSE_URI / MONGO_ANNEMASSE_URI sont requises en production, vides en dev.
# Creds annemasse optionnels : vides → mêmes comptes que Réunion (grantés sur les deux).
MYSQL_ANNEMASSE_URI=   # mysql://... — required in production, leave empty for local dev
MYSQL_ANNEMASSE_USER=
MYSQL_ANNEMASSE_PASSWORD=
MYSQL_ANNEMASSE_DATABASE=disciplina_annemasse
MONGO_ANNEMASSE_URI=   # mongodb://... — required in production, leave empty for local dev
MONGO_ANNEMASSE_USERNAME=
MONGO_ANNEMASSE_PASSWORD=
MONGO_ANNEMASSE_DATABASE=disciplina_annemasse
DB_DEFAULT_TENANT=reunion

OAUTH_ENCRYPTION_KEY=   # 64-char hex — generate with: openssl rand -hex 32
SSN_ENCRYPTION_KEY=ca8b3584e39e348284771bb25ff0bff6fe6bd3d645ff83d6a66899a01244203f

CORS_ORIGINS=   # comma-separated origins — required in production, defaults to localhost only
