    {
      "parameters": {
        "jsCode": "// Assemble tous les mails en un seul bloc texte pour le LLM.\nconst items = $input.all();\nif (items.length === 0) {\n  return [{ json: { blob: 'AUCUN MAIL trouve avec le label Veille le mois dernier.', count: 0 } }];\n}\nconst blob = items.map((it, i) => {\n  const j = it.json;\n  const sujet = j.subject || j.Subject || '(sans sujet)';\n  const date = j.date || j.internalDate || '';\n  const corps = j.text || j.textAsHtml || j.snippet || '';\n  return `### MAIL ${i + 1}\\nSujet: ${sujet}\\nDate: ${date}\\nContenu:\\n${corps}`;\n}).join('\\n\\n---\\n\\n');\nreturn [{ json: { blob, count: items.length } }];"
      },
      "id": "a4444444-4444-4444-4444-444444444444",
      "name": "Assemble les mails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
