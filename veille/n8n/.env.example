# --- n8n config ---
N8N_PORT=5678

# Accès local (défaut). Pour déployer : mets ton domaine + https.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Clé de chiffrement des credentials/OAuth. NE PAS CHANGER une fois des credentials créés.
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

GENERIC_TIMEZONE=Indian/Reunion
