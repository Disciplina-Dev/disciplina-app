      "id": "482b81e4-96f2-4271-b471-ad6c2c587f95",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -16,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calcule la plage du MOIS PRECEDENT (du 1er 00h00 au 1er du mois courant 00h00)\nconst now = new Date();\nconst startPrev = new Date(now.getFullYear(), now.getMonth() - 1, 1, 0, 0, 0, 0);\nconst startCurrent = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);\n\nconst otStart = Math.floor(startPrev.getTime() / 1000);   // borne basse (incluse)\nconst otEnd = Math.floor(startCurrent.getTime() / 1000);  // borne haute (exclue)\n\nconst moisFr = ['janvier','fevrier','mars','avril','mai','juin','juillet','aout','septembre','octobre','novembre','decembre'];\nconst libelle = moisFr[startPrev.getMonth()] + ' ' + startPrev.getFullYear();\n\nreturn [{ json: { otStart, otEnd, libelle } }];"
      },
      "id": "4d0f72a6-af12-4fe8-a6f9-d9412cd0ade1",
      "name": "Calcul periode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.base }}/api/greader.php/accounts/ClientLogin",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "Email",
              "value": "={{ $('Config').first().json.user }}"
            },
            {
              "name": "Passwd",
              "value": "={{ $('Config').first().json.apiPassword }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "43154350-3b61-487e-8e53-5c5c018a031d",
      "name": "Login FreshRSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        432,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extrait le token Auth= de la reponse ClientLogin\nconst raw = $input.first().json.data ?? $input.first().json.body ?? '';\nconst m = String(raw).match(/Auth=(.+)/);\nif (!m) { throw new Error('Token Auth introuvable. Verifie l API password et que l acces API est active dans FreshRSS.'); }\nreturn [{ json: { token: m[1].trim() } }];"
      },
      "id": "cbe3bec0-4784-41db-932f-667f3f27d5ba",
      "name": "Extract token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -96
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.base }}/api/greader.php/reader/api/0/stream/contents/user/-/state/com.google/reading-list",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "output",
              "value": "json"
            },
            {
              "name": "n",
              "value": "1000"
            },
            {
              "name": "r",
              "value": "o"
            },
            {
              "name": "ot",
              "value": "={{ $('Calcul periode').first().json.otStart }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=GoogleLogin auth={{ $json.token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "623d784e-9935-4708-8bda-00ff05a36734",
      "name": "Recuperer les articles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        864,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Garde uniquement les articles dont la date est DANS le mois precedent\nconst otStart = $('Calcul periode').first().json.otStart;\nconst otEnd = $('Calcul periode').first().json.otEnd;\nconst resp = $input.first().json;\nconst items = resp.items || [];\n\nconst out = [];\nfor (const it of items) {\n  const ts = Number(it.published) || (it.timestampUsec ? Math.floor(Number(it.timestampUsec) / 1000000) : 0);\n  if (ts >= otStart && ts < otEnd) {\n    out.push({ json: {\n      titre: it.title || '(sans titre)',\n      lien: (it.canonical && it.canonical[0] && it.canonical[0].href) || (it.alternate && it.alternate[0] && it.alternate[0].href) || '',\n      date: new Date(ts * 1000).toISOString().slice(0, 10),\n      source: (it.origin && it.origin.title) || ''\n    }});\n  }\n}\nreturn out;"
      },
      "id": "8658ea66-64be-4e55-b955-a2393eed8539",
      "name": "Filtrer mois precedent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Regroupe tous les articles en un seul mail HTML, tries par source\nconst arts = $input.all().map(i => i.json);\nconst libelle = $('Calcul periode').first().json.libelle;\narts.sort((a, b) => (a.source || '').localeCompare(b.source || ''));\n\nlet html = '<h2>Veille OPCO - ' + libelle + '</h2>';\nhtml += '<p>' + arts.length + ' article(s) publie(s) le mois dernier.</p><ul>';\nfor (const a of arts) {\n  html += '<li><strong>' + a.source + '</strong> - <a href=\"' + a.lien + '\">' + a.titre + '</a> <em>(' + a.date + ')</em></li>';\n}\nhtml += '</ul>';\n\nreturn [{ json: { libelle, count: arts.length, html } }];"
      },
      "id": "d4db42f0-8626-45dd-9138-8495c52cd0b6",
      "name": "Agreger en HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
