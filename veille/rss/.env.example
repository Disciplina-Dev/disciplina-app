# Configuration FreshRSS — copier en .env : cp .env.example .env
# Toutes les valeurs sont lues par docker-compose.yml.

# Fuseau horaire du conteneur (horodatage de la veille = preuve Qualiopi).
# La Réunion = Indian/Reunion (UTC+4).
TZ=Indian/Reunion

# Port HTTP exposé sur la machine hôte. Interface sur http://localhost:<PORT>.
# Changer si 8080 déjà utilisé (ex: 9090).
FRESHRSS_PORT=8080

# Fréquence du rafraîchissement automatique des flux (syntaxe cron, champ minutes).
# */30 = toutes les 30 minutes. */15 = tous les quarts d'heure. 0 = chaque heure pile.
CRON_MIN=*/30
