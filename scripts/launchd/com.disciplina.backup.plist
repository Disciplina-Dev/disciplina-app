<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.disciplina.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/ABSOLUTE/PATH/TO/disciplina-app/scripts/backup-db.sh</string>
    </array>
    <!-- launchd starts agents with a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin), which does
         not contain the Docker CLI. Without this key, backup-db.sh fails with
         "docker: command not found" when launchd fires it, while running fine by hand.
         /usr/local/bin covers Docker Desktop on Intel, /opt/homebrew/bin on Apple Silicon. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/Library/Logs/disciplina-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/Library/Logs/disciplina-backup.log</string>
</dict>
</plist>
