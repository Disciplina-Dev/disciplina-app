# API
API_PORT=4001
SESSION_SECRET=test-session-secret
JWT_SECRET=test-jwt-secret
APP_BASE_URL=http://localhost:4001
RELANCE_HMAC_SECRET=test-relance-secret
GOOGLE_STATE_SECRET=test-google-state-secret

# MySQL (via docker compose: host port 5001 -> container 3306)
MYSQL_HOST=localhost
MYSQL_PORT=5001
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=mysql-secret-pw
MYSQL_DATABASE=sales_service

# MongoDB (via docker compose: host port 4011 -> container 27017)
MONGO_ROOT_USERNAME=mongo-user
MONGO_ROOT_PASSWORD=mongo-secret-pw
MONGO_PORT=27017
MONGO_HOST=localhost
MONGO_DB_NAME=human_ressources_test

# Google OAuth — optional for tests
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google

# SMTP — optional for tests
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ClassMarker — optional for tests
CLASSMARKER_API_NAME=
CLASSMARKER_API_KEY=
CLASSMARKER_API_SECRET=
