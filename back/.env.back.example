CI=true

# Read-only MCP server (CRM data via POST /api/mcp). Bearer token guarding the
# endpoint. Leave empty to disable the MCP endpoint entirely (returns 404).
# Must be >= 32 chars or the endpoint stays disabled. Generate with:
#   openssl rand -hex 32
# Serve over HTTPS only; never expose this key in the frontend or commit it.
MCP_API_KEY=

# MYSQL Secret
MYSQL_USER=root
MYSQL_DATABASE=disciplina
MYSQL_URI=   # mysql://... — required in production, leave empty for local dev

# Google Secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google
GOOGLE_STATE_SECRET=GoogleStateSecret
